// GET /api/groups/:id/assignments — 小组作业列表
router.get('/:id/assignments', authMiddleware, (req, res) => {
  const assignments = db.prepare(`SELECT a.*, COUNT(aq.question_id) as question_count FROM assignments a LEFT JOIN assignment_questions aq ON a.id = aq.assignment_id WHERE a.group_id = ? GROUP BY a.id ORDER BY a.created_at DESC`).all(req.params.id);
  res.json({ assignments });
});
